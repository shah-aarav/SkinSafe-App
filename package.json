{
  "name": "skinsafe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && node scripts/icons.mjs && vite build",
    "prepare:judge-data": "node scripts/build-judge-data.mjs",
    "build:judge": "tsc -b && node scripts/icons.mjs && vite build --mode judge",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server.mjs",
    "phone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/phone.ps1",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "sharp": "^0.34.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
