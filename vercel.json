{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:judge",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/__clerk/:path*", "destination": "/api/clerk-proxy?path=:path*" }
  ],
  "functions": {
    "api/assess.js": {
      "includeFiles": "assets/judge-uploads/**"
    }
  }
}
